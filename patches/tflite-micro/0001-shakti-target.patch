+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+==============================================================================*/
+
+// SHAKTI (shakti-ai-sdk): time in core clock cycles (mcycle; user-mode rdcycle traps on cores without U mode).
+// SHAKTI_CLOCK_HZ: the core clock (the SoC's CLOCK_FREQUENCY), so ticks_per_second() converts to seconds.
+#include "tensorflow/lite/micro/micro_time.h"
+
+#ifndef SHAKTI_CLOCK_HZ
+#define SHAKTI_CLOCK_HZ 50000000
+#endif
+
+namespace tflite {
+namespace micro {
+
+uint32_t ticks_per_second() { return SHAKTI_CLOCK_HZ; }
+
+uint32_t GetCurrentTimeTicks() {
+  unsigned long cycles;
+  __asm__ volatile("csrr %0, mcycle" : "=r"(cycles));
+  return static_cast<uint32_t>(cycles);
+}
+
+}  // namespace micro
+}  // namespace tflite
