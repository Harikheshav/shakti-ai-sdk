diff --git a/tensorflow/lite/micro/tools/make/targets/shakti_makefile.inc b/tensorflow/lite/micro/tools/make/targets/shakti_makefile.inc
new file mode 100644
index 0000000..7467ea1
--- /dev/null
+++ b/tensorflow/lite/micro/tools/make/targets/shakti_makefile.inc
@@ -0,0 +1,30 @@
+# SHAKTI RISC-V cores (IIT Madras c-class) on SHAKTI SoCs; built by shakti-ai-sdk, which takes the ISA, ABI and
+# memory from the SoC's target description.  TARGET=shakti selects tensorflow/lite/micro/shakti/ (console
+# log, mcycle time).  SHAKTI_ARCH / SHAKTI_ABI: e.g. rv64imafdc_zicsr_zifencei / lp64d.
+TARGET_ARCH := riscv
+TARGET_TOOLCHAIN_PREFIX := riscv64-unknown-elf-
+
+SHAKTI_ARCH ?= rv64imafdc_zicsr_zifencei
+SHAKTI_ABI ?= lp64d
+
+PLATFORM_FLAGS = \
+  -march=$(SHAKTI_ARCH) \
+  -mabi=$(SHAKTI_ABI) \
+  -mcmodel=medany \
+  -fno-builtin-printf \
+  -DTF_LITE_MCU_DEBUG_LOG \
+  -DTF_LITE_USE_GLOBAL_CMATH_FUNCTIONS \
+  -funsigned-char \
+  -fno-delete-null-pointer-checks \
+  -fomit-frame-pointer
+
+CXXFLAGS += $(PLATFORM_FLAGS) \
+  -fno-use-cxa-atexit \
+  -DTF_LITE_USE_GLOBAL_MIN \
+  -DTF_LITE_USE_GLOBAL_MAX
+CCFLAGS += $(PLATFORM_FLAGS)
+
+BUILD_TYPE := micro
+LDFLAGS += --specs=nano.specs
+
+include $(MAKEFILE_DIR)/ext_libs/eyalroz_printf.inc
